{% extends "base.twig" %}

{% block title %}Domů{% endblock %}

{% block content %}
<section class="hero">
    <div class="row align-items-center">
        <div class="col-lg-7 mb-4 mb-lg-0">
            <div class="hero-badge">
                <span class="badge bg-success rounded-pill me-2 border border-light border-opacity-25">Nové</span>
                <span>Chytrá správa akcí pro studenty i organizátory</span>
            </div>
            <p class="hero-kpi mb-2">EventHub</p>
            <h1 class="display-5 fw-bold mb-3">Plánuj, sdílej a objevuj akce na jednom místě.</h1>
            <p class="lead mb-4">
                Tvoř vlastní workshopy, konference nebo meetup, sleduj kapacitu v reálném čase
                a objevuj, co se děje ve tvém okolí.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a href="/events" class="btn btn-primary btn-lg px-4">Prohlédnout akce</a>
                <a href="/register" class="btn btn-outline-light btn-lg px-4">Zaregistrovat se</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 bg-white bg-opacity-10 text-light">
                <div class="card-body">
                    <p class="text-uppercase small text-muted mb-1">Příští kroky</p>
                    <h5 class="mb-3">Jak začít s EventHubem</h5>
                    <ul class="list-unstyled mb-3">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Prohlédni si aktuální akce a workshopy</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Vytvoř vlastní akci a počkej na schválení</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Sdílej odkaz se spolužáky nebo týmem</li>
                    </ul>
                    <p class="small text-muted mb-0">Vše je zdarma a bez zbytečných komplikací.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}

