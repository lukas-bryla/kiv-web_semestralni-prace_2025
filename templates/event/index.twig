{% extends "base.twig" %}

{% block title %}Seznam akcí{% endblock %}

{% block content %}
<div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
    <div>
        <h1 class="mb-1">Aktuální akce</h1>
        <p class="text-muted mb-0">Vyfiltruj si akce podle názvu, místa nebo tagů.</p>
    </div>
    {% if session.user %}
        <a href="/event/create" class="btn btn-primary mt-3 mt-sm-0">
            <i class="bi bi-plus-circle me-1"></i> Přidat akci
        </a>
    {% endif %}
</div>

<form method="GET" action="/events" class="row g-3 mb-4 event-filters">
    <div class="col-md-6">
        <label class="form-label">Hledat</label>
        <input
            type="text"
            name="q"
            class="form-control"
            placeholder="název, místo, popis nebo tag"
            value="{{ filters.query|default('') }}"
        >
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check">
            <input
                class="form-check-input"
                type="checkbox"
                name="upcoming"
                value="1"
                id="upcomingCheck"
                {% if filters.only_upcoming|default(false) %}checked{% endif %}
            >
            <label class="form-check-label" for="upcomingCheck">
                Jen budoucí akce
            </label>
        </div>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filtrovat</button>
    </div>
</form>

{% if allTags is not empty %}
    {% set currentTagIds = filters.tag_ids|default([]) %}
    <div class="mb-3 popular-tags">
        <span class="me-2 text-muted">Tagy:</span>
        {% for tag in allTags %}
            {% set selected = tag.id in currentTagIds %}
            {% if selected %}
                {% set newTagIds = [] %}
                {% for id in currentTagIds %}
                    {% if id != tag.id %}
                        {% set newTagIds = newTagIds|merge([id]) %}
                    {% endif %}
                {% endfor %}
            {% else %}
                {% set newTagIds = currentTagIds|merge([tag.id]) %}
            {% endif %}

            {% set params = [] %}
            {% if filters.query is defined and filters.query %}
                {% set params = params|merge(['q=' ~ filters.query|url_encode]) %}
            {% endif %}
            {% if filters.only_upcoming|default(false) %}
                {% set params = params|merge(['upcoming=1']) %}
            {% endif %}
            {% for id in newTagIds %}
                {% set params = params|merge(['tags[]=' ~ id]) %}
            {% endfor %}

            <a
                href="/events{% if params %}?{{ params|join('&') }}{% endif %}"
                class="badge bg-secondary text-decoration-none me-1 mb-1{% if selected %} active-tag{% endif %}"
            >
                {{ tag.name }}
            </a>
        {% endfor %}
    </div>
{% endif %}

<p class="text-muted">
    Nalezeno {{ events|length }} akcí.
</p>

{% if events|length == 0 %}
    <p>Zatím žádné akce neodpovídají filtru.</p>
{% else %}
    <div class="row">
        {% for event in events %}
            <div class="col-md-4 mb-4">
                <div class="card h-100 event-card">
                    {% if event.image %}
                        <img
                            src="/uploads/{{ event.image }}"
                            class="card-img-top"
                            style="height:200px; object-fit:cover;"
                            alt="{{ event.title }}"
                        >
                    {% else %}
                        <img
                            src="/assets/images/placeholder-event.webp"
                            class="card-img-top"
                            style="height:200px; object-fit:cover;"
                            alt="Placeholder for {{ event.title }}"
                        >
                    {% endif %}
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ event.title }}</h5>
                        <p class="card-text event-meta">
                            {{ event.date|date('j. n. Y H:i') }} • {{ event.location }}
                        </p>

                        {% if session.user and registeredEventIds is defined and event.id in registeredEventIds %}
                            <p class="mb-2">
                                <span class="badge bg-success">Registrováno</span>
                            </p>
                        {% endif %}

                        {% if event.tags %}
                            <p class="mb-2">
                                {% for tag in event.tags|split(',') %}
                                    {% set t = tag|trim %}
                                    {% if t %}
                                        <span class="badge tag-badge me-1">{{ t }}</span>
                                    {% endif %}
                                {% endfor %}
                            </p>
                        {% endif %}

                        <a href="/event/{{ event.id }}" class="btn btn-primary mt-auto">Detail</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

{% endblock %}
