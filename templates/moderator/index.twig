{% extends "base.twig" %}

{% block title %}Moderátorský panel{% endblock %}

{% block content %}
<h1 class="mb-4">Moderátorský panel</h1>

<div class="row">
    <div class="col-lg-6 mb-4">
        <h2 class="h5 mb-3">Čekající akce ke schválení</h2>
        {% if pendingEvents|length == 0 %}
            <p class="text-muted">Žádné akce nečekají na schválení.</p>
        {% else %}
            <table class="table table-striped table-sm align-middle">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Název</th>
                    <th>Autor</th>
                    <th>Akce</th>
                </tr>
                </thead>
                <tbody>
                {% for event in pendingEvents %}
                    <tr>
                        <td>{{ event.id }}</td>
                        <td>{{ event.title }}</td>
                        <td>{{ event.author }}</td>
                        <td>
                            <form method="POST" action="/moderator/event/approve/{{ event.id }}" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Schválit</button>
                            </form>
                            <form method="POST" action="/moderator/event/reject/{{ event.id }}" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Opravdu odmítnout a smazat akci?');">
                                    Odmítnout
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <div class="col-lg-6 mb-4">
        <h2 class="h5 mb-3">Čekající komentáře</h2>
        {% if pendingComments|length == 0 %}
            <p class="text-muted">Žádné komentáře nečekají na schválení.</p>
        {% else %}
            <div class="list-group">
                {% for comment in pendingComments %}
                    <div class="list-group-item">
                        <div class="small text-muted d-flex justify-content-between">
                            <span>{{ comment.username }} u akce „{{ comment.event_title }}“</span>
                            <span>{{ comment.created_at|date('j. n. Y H:i') }}</span>
                        </div>
                        <p class="mb-2">{{ comment.content|e }}</p>
                        <div>
                            <form method="POST" action="/moderator/comment/approve/{{ comment.id }}" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm">Schválit</button>
                            </form>
                            <form method="POST" action="/moderator/comment/reject/{{ comment.id }}" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm">Skrýt</button>
                            </form>
                            <a href="/event/{{ comment.event_id }}" class="btn btn-link btn-sm">Otevřít akci</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
