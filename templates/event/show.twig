{% extends "base.twig" %}

{% block title %}{{ event.title }}{% endblock %}

{% block content %}
<div class="card event-card">
    {% if event.image %}
        <img src="/uploads/{{ event.image }}" class="card-img-top" alt="{{ event.title }}">
    {% endif %}
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
            <div>
                <h1 class="mb-1">{{ event.title }}</h1>
                <p class="event-meta mb-0">
                    {{ event.date|date('j. n. Y H:i') }} • {{ event.location }}
                </p>
                <p class="text-muted mb-1"><small>Autor: {{ event.author }}</small></p>
            </div>
            <div class="text-end mt-3 mt-sm-0">
                <p class="mb-1">
                    <strong>Volná místa:</strong>
                    <span id="free-spots">Načítám...</span> / {{ event.capacity }}
                </p>
                {% if session.user %}
                    {% if isRegistered %}
                        <p class="mb-1"><span class="badge bg-success">Jsi registrován na tuto akci</span></p>
                    {% else %}
                        <form method="POST" action="/event/{{ event.id }}/register" class="d-inline">
                            <button type="submit" class="btn btn-primary btn-sm">Registrovat se</button>
                        </form>
                    {% endif %}
                {% endif %}
                {% if event.tags %}
                    <div class="mt-2">
                        {% for tag in event.tags|split(',') %}
                            {% set t = tag|trim %}
                            {% if t %}
                                <span class="badge tag-badge me-1">{{ t }}</span>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <hr>
        {{ event.description|raw }}

        <hr class="my-4">
        <h3 class="h5 mb-3">Komentáře</h3>

        {% if comments is not empty %}
            <div class="list-group mb-3">
                {% for comment in comments %}
                    <div class="list-group-item comment-item border-0 border-bottom px-0">
                        <div class="d-flex justify-content-between mb-1 small text-muted">
                            <span>{{ comment.username }}</span>
                            <span>{{ comment.created_at|date('j. n. Y H:i') }}</span>
                        </div>
                        <p class="mb-0 comment-text">{{ comment.content|e }}</p>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="text-muted mb-3">Zatím žádné komentáře.</p>
        {% endif %}

        {% if session.user %}
            <form method="POST" action="/event/{{ event.id }}/comment" class="mt-3">
                <div class="mb-2">
                    <label for="comment-content" class="form-label">Přidat komentář</label>
                    <textarea id="comment-content" name="content" class="form-control" rows="3" required></textarea>
                </div>
                <p class="small text-muted mb-2">
                    Komentář se zobrazí až po schválení moderátorem.
                </p>
                <button type="submit" class="btn btn-primary btn-sm">Odeslat komentář</button>
            </form>
        {% else %}
            <p class="mt-3 text-muted">
                Pro přidání komentáře se prosím <a href="/login">přihlas</a>.
            </p>
        {% endif %}

        {% if session.user and session.user.role in ['moderator','admin','superadmin'] %}
            <hr class="my-4">
            <h3 class="h6 mb-2">Registrovaní účastníci</h3>
            {% if registrations is not empty %}
                <ul class="list-unstyled small mb-0">
                    {% for reg in registrations %}
                        <li class="mb-1">
                            <strong>{{ reg.username }}</strong>
                            <span class="text-muted">({{ reg.email }}) – registrován {{ reg.created_at|date('j. n. Y H:i') }}</span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted small mb-0">Na akci zatím není nikdo registrován.</p>
            {% endif %}
        {% endif %}
    </div>
</div>

<script>
    const es = new EventSource('/sse/free-spots.php?event_id={{ event.id }}');
    es.onmessage = (e) => {
        document.getElementById('free-spots').textContent = e.data;
    };
    es.onerror = (err) => {
        document.getElementById('free-spots').textContent = 'N/A (chyba spojení)';
        console.error('SSE error:', err);
        es.close();
    };
</script>
{% endblock %}
